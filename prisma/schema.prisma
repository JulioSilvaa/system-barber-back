generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String          @id
  name         String
  email        String          @unique
  phone        String
  password     String?
  globalRole   String          @default("USER")
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  memberships  UserBarbershop[]
  appointments Appointment[]   @relation("BarberAppointments")

  @@map("users")
}

model Barbershop {
  id           String          @id
  name         String
  slug         String          @unique
  phone        String
  password     String?
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  memberships  UserBarbershop[]
  services     Service[]
  appointments Appointment[]

  @@map("barbershops")
}

model UserBarbershop {
  id           String     @id
  userId       String
  barbershopId String
  status       String     @default("ACTIVE")
  localRole    String     @default("BARBER")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@unique([userId, barbershopId])
  @@map("user_barbershops")
}

model Service {
  id              String        @id
  barbershopId    String
  name            String
  priceCents      Int
  durationMinutes Int
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  barbershop      Barbershop    @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  appointments    Appointment[]

  @@map("services")
}

model Appointment {
  id            String     @id
  barbershopId  String
  barberId      String
  serviceId     String
  customerName  String
  customerPhone String
  startDate     DateTime
  endDate       DateTime
  status        String     @default("SCHEDULED")
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  barbershop    Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  barber        User       @relation("BarberAppointments", fields: [barberId], references: [id])
  service       Service    @relation(fields: [serviceId], references: [id])

  @@map("appointments")
}
