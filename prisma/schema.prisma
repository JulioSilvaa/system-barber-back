generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String           @id
  name         String
  email        String           @unique
  phone        String?
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  memberships  UserBarbershop[]
  appointments Appointment[]    @relation("BarberAppointments")
  commissions  Commission[]     @relation("BarberCommissions")
  evaluations  Evaluation[]     @relation("BarberEvaluations")

  @@map("users")
}

model Admin {
  id        String   @id
  name      String
  email     String   @unique
  password  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admins")
}

model Barbershop {
  id            String                 @id
  name          String
  slug          String                 @unique
  email         String                 @unique
  phone         String
  password      String
  primaryColor  String?
  logoUrl       String?
  isActive      Boolean                @default(true)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  memberships   UserBarbershop[]
  services      Service[]
  appointments  Appointment[]
  customers     Customer[]
  workingHours  WorkingHours[]
  commissions   Commission[]
  cashRegisters CashRegister[]
  movements     CashRegisterMovement[]
  evaluations   Evaluation[]

  @@map("barbershops")
}

model UserBarbershop {
  id             String     @id
  userId         String
  barbershopId   String
  status         String     @default("ACTIVE")
  localRole      String     @default("BARBER")
  commissionRate Int?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  barbershop     Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@unique([userId, barbershopId])
  @@map("user_barbershops")
}

model Service {
  id              String        @id
  barbershopId    String
  name            String
  priceCents      Int
  durationMinutes Int
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  barbershop      Barbershop    @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  appointments    Appointment[]

  @@map("services")
}

model Appointment {
  id             String                 @id
  barbershopId   String
  barberId       String
  serviceId      String
  customerId     String
  startDate      DateTime
  endDate        DateTime
  status         String                 @default("SCHEDULED")
  pricePaidCents Int?
  paymentMethod  String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  barbershop     Barbershop             @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  barber         User                   @relation("BarberAppointments", fields: [barberId], references: [id])
  service        Service                @relation(fields: [serviceId], references: [id])
  customer       Customer               @relation(fields: [customerId], references: [id])
  commissions    Commission[]
  movements      CashRegisterMovement[]
  evaluations    Evaluation[]

  @@map("appointments")
}

model Customer {
  id           String        @id
  barbershopId String
  name         String
  phone        String
  email        String?
  isActive     Boolean       @default(true)
  vip          Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  barbershop   Barbershop    @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@unique([barbershopId, phone])
  @@map("customers")
}

model WorkingHours {
  id           String     @id
  barbershopId String
  dayOfWeek    Int
  isOpen       Boolean    @default(true)
  openTime     String?
  closeTime    String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@unique([barbershopId, dayOfWeek])
  @@map("working_hours")
}

model AuditLog {
  id           String   @id
  actorId      String?
  actorType    String
  actorRole    String?
  barbershopId String?
  action       String
  entityType   String
  entityId     String
  before       Json?
  after        Json?
  createdAt    DateTime @default(now())

  @@index([entityType, entityId])
  @@index([barbershopId])
  @@index([actorId])
  @@map("audit_logs")
}

model Commission {
  id                String       @id
  barbershopId      String
  barberId          String
  appointmentId     String?
  serviceValueCents Int
  commissionCents   Int
  rate              Int
  isPaid            Boolean      @default(false)
  createdAt         DateTime     @default(now())
  barbershop        Barbershop   @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  barber            User         @relation("BarberCommissions", fields: [barberId], references: [id])
  appointment       Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([barbershopId])
  @@index([barberId])
  @@index([appointmentId])
  @@map("commissions")
}

model CashRegister {
  id                  String                 @id
  barbershopId        String
  openedKey           String
  openedAt            DateTime               @default(now())
  openingAmountCents  Int                    @default(0)
  closedAt            DateTime?
  closingAmountCents  Int?
  expectedAmountCents Int?
  differenceCents     Int?
  note                String?
  status              String                 @default("OPEN")
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  barbershop          Barbershop             @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  movements           CashRegisterMovement[]

  @@unique([barbershopId, openedKey])
  @@index([barbershopId, status])
  @@map("cash_registers")
}

model CashRegisterMovement {
  id             String       @id
  cashRegisterId String
  barbershopId   String
  kind           String
  category       String
  amountCents    Int
  description    String?
  appointmentId  String?
  createdAt      DateTime     @default(now())
  cashRegister   CashRegister @relation(fields: [cashRegisterId], references: [id], onDelete: Cascade)
  barbershop     Barbershop   @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  appointment    Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([cashRegisterId])
  @@index([appointmentId])
  @@map("cash_register_movements")
}

model Evaluation {
  id            String      @id
  barbershopId  String
  appointmentId String      @unique
  barberId      String
  rating        Int
  comment       String?
  createdAt     DateTime    @default(now())
  barbershop    Barbershop  @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  barber        User        @relation("BarberEvaluations", fields: [barberId], references: [id])

  @@index([barbershopId])
  @@index([barberId])
  @@map("evaluations")
}
