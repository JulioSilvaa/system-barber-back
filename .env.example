## JWT
JWT_ACCESS_SECRET=your_access_secret_here_change_in_production
JWT_REFRESH_SECRET=your_refresh_secret_here_change_in_production

# Bcrypt
BCRYPT_SALT=14

# Environment
PORT=3000

# Database
# Banco de desenvolvimento definido no docker-compose do projeto-pai (porta 5432)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/seu_banco_de_desenvolvimento"
# A suite de banco usa <db>_test (ex.: systembarber_test) na mesma instância,
# criada e sincronizada automaticamente pelo globalSetup do vitest.
# Driver: "memory" (sem banco) ou "prisma" (usa o DATABASE_URL)
DB_DRIVER=prisma

## Admin inicial da plataforma (criado pelo comando `yarn seed`)
## O dono da barbearia é a própria conta da barbearia (POST /api/barbershops, público).
ADMIN_NAME=Admin Plataforma
ADMIN_EMAIL=admin@exemplo.com
ADMIN_PASSWORD=SenhaForte123

## Criptografia AES-256-GCM (tokens externos - Meta/Instagram, LGPD)
ENCRYPTION_KEY=troque-por-uma-chave-secreta-longa-e-aleatoria

## Asaas (assinaturas BASIC/PRO)
ASAAS_API_URL=https://sandbox.asaas.com
ASAAS_API_KEY=troque-pela-chave-do-asaas
ASAAS_WEBHOOK_SECRET=troque-pelo-token-do-webhook-do-asaas
