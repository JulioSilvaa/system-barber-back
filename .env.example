# Docker Compose - Variáveis do Postgres
POSTGRES_DB=systembarber
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD

# JWT
JWT_ACCESS_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32

# Bcrypt
BCRYPT_SALT=14

# Environment
PORT=3000

# Database (usado fora do Docker - yarn dev)
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/systembarber"
DB_DRIVER=prisma

# Admin inicial da plataforma (criado pelo comando `yarn seed`)
ADMIN_NAME=Admin Plataforma
ADMIN_EMAIL=admin@exemplo.com
ADMIN_PASSWORD=CHANGE_ME_123

# Criptografia AES-256-GCM (tokens externos - Meta/Instagram, LGPD)
ENCRYPTION_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32

# Asaas (assinaturas BASIC/PRO)
# Sandbox: https://api-sandbox.asaas.com/v3 | Produção: https://api.asaas.com/v3
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=CHANGE_ME
# Token configurado no Webhook do painel Asaas (validado via header asaas-access-token)
ASAAS_WEBHOOK_SECRET=CHANGE_ME_GENERATE_32_TO_255_CHARS

# Preços mensais dos planos (em reais)
PLAN_PRICE_BASIC=99.90
PLAN_PRICE_PRO=199.90

# Push Notifications (VAPID)
VAPID_PUBLIC_KEY=CHANGE_ME
VAPID_PRIVATE_KEY=CHANGE_ME
VAPID_SUBJECT=mailto:admin@systembarber.com
