## JWT
JWT_ACCESS_SECRET=your_access_secret_here_change_in_production
JWT_REFRESH_SECRET=your_refresh_secret_here_change_in_production

# Bcrypt
BCRYPT_SALT=14

# Environment
PORT=3000

# Database
DATABASE_URL="file:./prisma/dev.db"
# Driver: "memory" (sem banco) ou "prisma" (usa o DATABASE_URL)
DB_DRIVER=prisma

## SUPER_ADMIN inicial (criado pelo comando `yarn seed`)
ADMIN_NAME=Seu Nome
ADMIN_EMAIL=admin@exemplo.com
ADMIN_PHONE=11999999999
ADMIN_PASSWORD=SenhaForte123
